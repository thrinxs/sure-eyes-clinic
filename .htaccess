# Enable rewrite engine
RewriteEngine On

# Force HTTPS and www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.sureeyesclinic.com.ng%{REQUEST_URI} [L,R=301]

# Remove .php or .html extension from URLs
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/]+)$ $1.html [L]

# Redirect .html URLs to clean URLs (optional)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.html [NC]
RewriteRule ^ %1 [R=301,L]

# If you ever add .php files, you can add similar rules:
# RewriteRule ^([^/]+)$ $1.php [L]
